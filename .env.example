# Environment Configuration for SauceDemo Testing
# Copy this file to .env and update values as needed

# SauceDemo Base URL
SAUCEDEMO_BASE_URL=https://www.saucedemo.com

# Test User Credentials
SAUCEDEMO_STANDARD_USER=standard_user
SAUCEDEMO_LOCKED_OUT_USER=locked_out_user
SAUCEDEMO_PROBLEM_USER=problem_user
SAUCEDEMO_PERFORMANCE_GLITCH_USER=performance_glitch_user
SAUCEDEMO_ERROR_USER=error_user
SAUCEDEMO_VISUAL_USER=visual_user

# Common Password for all users
SAUCEDEMO_PASSWORD=secret_sauce

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# Test Configuration
TEST_PARALLEL_WORKERS=4
TEST_RERUNS=1
TEST_RERUNS_DELAY=1

# Reporting
REPORT_RESULTS=true
REPORT_COVERAGE=true
REPORT_HTML=true

# CI/CD Configuration
CI=false
GITHUB_ACTIONS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/test_execution.log